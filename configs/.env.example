# 复制为 .env 后由 deploy.sh 自动加载

# 本机安装前缀
# INSTALL_PREFIX=/opt/proctor

# Agent OTA 发布目录（publish_update / package 自动写入）
# DATA_DIR=./data
# UPDATES_DIR=./data/updates
# APP_VERSION=0.2.0
# SKIP_PUBLISH_UPDATE=1

# Agent 开发运行
# SERVER_URL=http://127.0.0.1:8080
# STUDENT_NAME=张三
# CLASSROOM=高一1班

# Server 控制台 Basic Auth（对应 configs/server.json；密码留空可关闭）
# BASIC_AUTH_USER=proctor
# BASIC_AUTH_PASSWORD=proctor

# 远程部署（remote_* / upload，基于 SSH）
# REMOTE_SSH_HOST=root@192.168.1.10
# REMOTE_SSH_PORT=22
# REMOTE_SSH_KEY=~/.ssh/id_rsa
# REMOTE_SSH_PASSWORD=
# REMOTE_PATH=/tmp
# Windows 学生机示例（需 OpenSSH Server；也可 --os windows）
# REMOTE_SSH_HOST=Administrator@192.168.1.20
# REMOTE_OS=windows
# REMOTE_PATH=C:/Windows/Temp
